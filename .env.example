# ---------------------------------------------------------------------------
# Database: Supabase Postgres
# ---------------------------------------------------------------------------
# The app talks to Postgres directly (Drizzle). No Supabase API keys are used,
# and none should be set: the Data API is closed to anon/authenticated.

# App connection, as the `pushguard` login role (owns nothing, switches role per
# transaction). On Vercel use the Supavisor transaction pooler, port 6543:
#   postgres://pushguard.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local (npm run db:local):
#   postgres://pushguard:pushguard@localhost:54329/postgres
DATABASE_URL=

# Migrations only (npm run db:migrate), as the `postgres` role. Session pooler
# (port 5432) or the direct connection. Do not set on Vercel.
# Local: postgres://postgres:postgres@localhost:54329/postgres
DATABASE_ADMIN_URL=

# One-time copy of the old Mongo database (npm run db:copy-mongo). Remove after.
MONGODB_URI=

# Live dashboard updates (Supabase Realtime broadcast). Project URL and the
# anon/publishable key. Safe in the browser: anon is granted nothing in the app
# schema. Unset means pages update on their next load instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# One-time SQL after the first migration, in the Supabase SQL editor:
#   alter role pushguard password '<strong password>';
#   select vault.create_secret('https://<your-app>/api/jobs/run', 'jobs_run_url');
#   select vault.create_secret('<same value as CRON_SECRET>', 'jobs_run_secret');

# ---------------------------------------------------------------------------
# Job runner
# ---------------------------------------------------------------------------
# Bearer for /api/jobs/run, sent by the database when a job is queued. 32+ chars.
# openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# GitHub App (github.com/settings/apps, public so any account can install)
# ---------------------------------------------------------------------------
# Permissions: Contents read, Metadata read, Issues write, Pull requests read,
#   Dependabot alerts read,
#   Administration read, Members read (organization), Actions read (downloads
#   workflow run logs to scan for secret dumps; without it no logs are scanned
#   and a 403 is logged once a day per org).
# Events: push, pull_request, installation, installation_repositories,
#   repository, public, create, delete, member, membership, organization, team,
#   issues, issue_comment, deploy_key, branch_protection_rule, repository_ruleset,
#   security_advisory (global malware advisories; retro-alerts dependents),
#   workflow_run (log scan), release (tag-protection posture),
#   dependabot_alert (GitHub's own match of malware advisories to each repo).
# Runner: triggered by creating a label, which Issues write already covers;
#   no Contents write needed. See runner/README.md.
# Webhook URL: https://<your-app>/api/webhook
# Setup URL:   https://<your-app>/api/install/complete
#   with "Request user authorization (OAuth) during installation" on.
# Keep "Expire user authorization tokens" on; sessions refresh the token.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
NEXT_PUBLIC_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# Sign-in (Auth.js): the GitHub App's own Client ID and secret
# ---------------------------------------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Public origin, e.g. https://<your-app>. Local: http://localhost:3000
AUTH_URL=
# Pushguard-hosted runner repository (owner/name) with the App installed; unset turns detonation off.
# RUNNER_REPO=owner/pushguard-runner

# ---------------------------------------------------------------------------
# Model keys
# ---------------------------------------------------------------------------
# Encrypts the model API keys accounts add in the dashboard. openssl rand -hex 32
ENCRYPTION_KEY=


# ---------------------------------------------------------------------------
# Staff console (/admin)
# ---------------------------------------------------------------------------
# GitHub logins allowed into the console, comma-separated. Empty means nobody:
# /admin answers 404 for everyone.
PLATFORM_ADMINS=

# ed25519 keys that sign staff-published rules and checks. Generate with `npm run keys:playbook` (printed, never written to
# disk). Keep the private key in the host's secret store (Vercel env, encrypted),
# never in a file in the repo. Unset private key: nothing can be published.
# Unset public key: derived from the private key.
# PLAYBOOK_SIGNING_KEY=
# PLAYBOOK_PUBLIC_KEY=

# The AI security expert drafts rules on the platform's own key. Unset key
# means the feature is off. Provider defaults to anthropic.
# PLATFORM_AI_KEY=
# PLATFORM_AI_PROVIDER=anthropic
# PLATFORM_AI_MODEL=claude-opus-5-5
